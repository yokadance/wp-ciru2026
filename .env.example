# =====================================================
# Variables de entorno — EJEMPLO
# Copiar a .env y completar con valores reales
# =====================================================

# Base de datos
DB_NAME=congreso_ciru
DB_USER=wp_user
DB_PASSWORD=cambiar_por_password_seguro
DB_ROOT_PASSWORD=cambiar_por_root_password_seguro

# Puertos locales (cambiar si hay conflictos)
WP_PORT=8080
PMA_PORT=8081

# WordPress debug (1=activado, 0=desactivado)
WP_DEBUG=1

# Datos del sitio (usados por make setup)
WP_URL=http://localhost:8080
WP_TITLE=76 Congreso Uruguayo de Cirugia 2026
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=cambiar_por_password_seguro
WP_ADMIN_EMAIL=admin@ejemplo.com
